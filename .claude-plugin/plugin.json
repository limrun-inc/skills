{
  "name": "limrun",
  "displayName": "Limrun",
  "version": "0.5.0",
  "description": "Cloud iOS simulators and Android emulators your agent can create, drive, and throw away.",
  "author": {
    "name": "Limrun",
    "url": "https://limrun.com"
  },
  "homepage": "https://limrun.com",
  "repository": "https://github.com/limrun-inc/skills",
  "license": "MIT",
  "keywords": [
    "ios",
    "android",
    "simulator",
    "emulator",
    "mobile",
    "testing",
    "xcode",
    "gradle",
    "expo",
    "mcp"
  ],
  "mcpServers": "./.mcp.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-loaded.mjs\" claude-code",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
